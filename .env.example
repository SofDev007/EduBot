# Copy this file to ".env" and fill in real values. NEVER commit the real .env.

# Flask
SECRET_KEY=change-me-to-a-long-random-secret
FLASK_ENV=production
FLASK_DEBUG=0
APP_BASE_URL=http://localhost:5000
TZ_NAME=Asia/Kolkata

# AI question generation (NVIDIA NIM)
NVIDIA_API_KEY=nvapi-your-key-here

# Database (three options — use only one):
#
# Option 1 (recommended for Render): paste the connection string from Supabase / Neon / Render add-on
# DATABASE_URL=postgresql://user:password@host:5432/dbname
#
# Option 2 (self-managed MySQL):
# DB_TYPE=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-db-password
# MYSQL_DB=railway
#
# Option 3 (local development default — data lost on Render restarts):
DB_TYPE=sqlite

# Email / SMTP (password reset notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
MAIL_FROM=your-email@example.com
